{
  "name": "tideline-city-twin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4246 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4247 --strictPort",
    "test": "vitest run",
    "test:browser": "node scripts/verify.mjs",
    "validate": "npm test && npm run build && npm run test:browser"
  },
  "engines": { "node": ">=22.18.0" },
  "dependencies": { "three": "0.186.1" },
  "devDependencies": {
    "@types/three": "^0.183.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "playwright": "^1.65.0"
  }
}
